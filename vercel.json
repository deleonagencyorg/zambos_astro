{
  "rewrites": [
    {
      "source": "/franquicias",
      "destination": "https://zambos-truck-franchise.vercel.app/"
    },
    {
      "source": "/franquicias/",
      "destination": "https://zambos-truck-franchise.vercel.app/"
    },
    {
      "source": "/franquicias/:path*",
      "destination": "https://zambos-truck-franchise.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|css|js|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
