{
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/es/", "statusCode": 301 },
    { "source": "/producto", "destination": "/es/productos/", "statusCode": 301 },
    { "source": "/producto/", "destination": "/es/productos/", "statusCode": 301 },
    { "source": "/producto/:slug", "destination": "/es/productos/:slug/", "statusCode": 301 },
    { "source": "/producto/:slug/", "destination": "/es/productos/:slug/", "statusCode": 301 },
    { "source": "/en/producto/:slug", "destination": "/us/products/", "statusCode": 301 },
    { "source": "/en/producto/:slug/", "destination": "/us/products/", "statusCode": 301 },
    { "source": "/receta/:slug", "destination": "/es/recetas/", "statusCode": 301 },
    { "source": "/receta/:slug/", "destination": "/es/recetas/", "statusCode": 301 },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "statusCode": 301 }
  ],
  "rewrites": [
    {
      "source": "/franquicias",
      "destination": "https://zambos-truck-franchise.vercel.app/"
    },
    {
      "source": "/franquicias/",
      "destination": "https://zambos-truck-franchise.vercel.app/"
    },
    {
      "source": "/franquicias/:path*",
      "destination": "https://zambos-truck-franchise.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|css|js|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/es",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "US" }],
      "missing": [{ "type": "cookie", "key": "user_country" }],
      "headers": [
        { "key": "Set-Cookie", "value": "user_country=US; Path=/; Max-Age=2592000; SameSite=Lax" }
      ]
    },
    {
      "source": "/es/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "US" }],
      "missing": [{ "type": "cookie", "key": "user_country" }],
      "headers": [
        { "key": "Set-Cookie", "value": "user_country=US; Path=/; Max-Age=2592000; SameSite=Lax" }
      ]
    },
    {
      "source": "/es/:path*",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "US" }],
      "missing": [{ "type": "cookie", "key": "user_country" }],
      "headers": [
        { "key": "Set-Cookie", "value": "user_country=US; Path=/; Max-Age=2592000; SameSite=Lax" }
      ]
    }
  ]
}
