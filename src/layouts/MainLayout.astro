---
import GoogleTagManager from '../components/common/GoogleTagManager.astro';
import UsSuggestionBanner from '../components/common/UsSuggestionBanner.astro';
import SEOHead from '../components/SEOHead.astro';
import Favicon from '../components/Favicon.astro';
// import GoogleTagManager from './i18n/GoogleTagManager.astro';
// import GoogleTagManagerNoScript from './i18n/GoogleTagManagerNoScript.astro';
import { type Locale } from '../i18n/i18n'; // t is not used, Locale type might be needed
import Header from '../components/common/Header/index.astro';
import Footer from '../components/common/Footer/index.astro';
import MobileMenu from '../components/common/MobileMenu/index.astro';
import I18nProvider from '../components/i18n/I18nProvider.astro';
import YouTubeVideoModal from '../components/common/YouTubeVideoModal.astro';
import { routesConfig } from '../config/routes';
import esProducts from '../locales/es/products.json';
import usProducts from '../locales/us/products.json';
import { getHeaderColors } from '../config/headerColors';
import { ViewTransitions } from 'astro:transitions';
import "../styles/global.css";
import { head } from 'framer-motion/m';

export interface Props {
  title?: string;
  description?: string;
  class?: string;
  headerColors?: {
    backgroundColor?: string;
    textColor?: string;
  };
}

const { title, description, class: className, headerColors } = Astro.props;

// Determine language for <html lang=...> and for key prop from the URL
const pathSegments = Astro.url.pathname.split('/');
const langFromUrl = pathSegments[1] as Locale;
const validLocales: Locale[] = ['es', 'us'];
const currentLang = validLocales.includes(langFromUrl) ? langFromUrl : 'es'; // Default to 'es'

// SEO: ISO lang code ('us' is not valid, must be 'en')
const htmlLang = currentLang === 'us' ? 'en' : 'es';

const { pathname } = Astro.url;

const recipeIds: Record<string, Set<string>> = {
  es: new Set(
    Object.keys(import.meta.glob('../locales/es/recipes/*.json')).map((file) => file.split('/').pop()!.replace('.json', ''))
  ),
  us: new Set(
    Object.keys(import.meta.glob('../locales/us/recipes/*.json')).map((file) => file.split('/').pop()!.replace('.json', ''))
  ),
};
const productIds: Record<string, Set<string>> = {
  es: new Set(esProducts.items.map((item) => item.id)),
  us: new Set(usProducts.items.map((item) => item.id)),
};

function getAlternatePath(toLang: 'es' | 'us'): string | undefined {
  const segs = pathname.split('/').filter(Boolean);
  const slug = segs[1] || '';
  if (!slug) return `/${toLang}/`;
  const route = routesConfig.find((item) => item.slugs[currentLang] === slug);
  const toSlug = route?.slugs[toLang];
  if (!route || !toSlug) return undefined;
  const rest = segs.slice(2);
  if (rest.length === 0) return `/${toLang}/${toSlug}/`;
  const detailId = rest.length === 1 ? rest[0] : '';
  if (route.id === 'recipes' && recipeIds[toLang]?.has(detailId)) {
    return `/${toLang}/${toSlug}/${detailId}/`;
  }
  if (route.id === 'products' && productIds[toLang]?.has(detailId)) {
    return `/${toLang}/${toSlug}/${detailId}/`;
  }
  return undefined;
}

const esPath = currentLang === 'es' ? pathname : getAlternatePath('es');
const enPath = currentLang === 'us' ? pathname : getAlternatePath('us');
const documentTitle = !title
  ? 'Zambos'
  : title.includes('Zambos')
    ? title
    : `${title} | Zambos`;

// Obtener configuración de colores basada en la ruta actual
const headerColorConfig = getHeaderColors(pathname);

// Si se pasan colores de header específicos (por ejemplo, desde un producto), 
// crear una configuración personalizada
let customHeaderConfig = headerColorConfig;
if (headerColors) {
  customHeaderConfig = {
    ...headerColorConfig,
    backgroundColor: headerColors.backgroundColor ? `bg-[${headerColors.backgroundColor}]` : headerColorConfig.backgroundColor,
    textColor: headerColors.textColor ? headerColors.textColor : headerColorConfig.textColor, // Mantener el textColor original de getHeaderColors
  };
}
---
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <GoogleTagManager />
    <Favicon />
    <SEOHead
      title={documentTitle}
      description={description}
      alternates={[
        ...(esPath ? [{ lang: 'es', path: esPath }] : []),
        ...(enPath ? [{ lang: 'en-US', path: enPath }] : []),
      ]}
    />
    <ViewTransitions />
    <!-- Canonical & hreflang for SERPs -->
    <slot name="head" />
    {/* <GoogleTagManager /> */}
  </head>
  <body class={`font-sans min-h-screen flex flex-col ${className || ''}`}>
    <GoogleTagManager noscript />
    <UsSuggestionBanner />
    <I18nProvider>
      <slot name="header">
        <Header currentLang={currentLang} headerColors={headerColors} />
      </slot>
      <main transition:animate="slide" class="flex-1 flex flex-col overflow-hidden">
        <slot />
      </main>
      <Footer currentLang={currentLang} />
    </I18nProvider>
    
    <!-- Menú móvil al final del body para máximo z-index -->
    <MobileMenu currentLang={currentLang} headerColorConfig={customHeaderConfig} />
    <YouTubeVideoModal showTrigger={false} />
  </body>
</html>
