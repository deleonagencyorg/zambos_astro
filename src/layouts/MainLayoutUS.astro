---
import GoogleTagManager from '../components/common/GoogleTagManager.astro';
import SEOHead from '../components/SEOHead.astro';
import Favicon from '../components/Favicon.astro';
import { type Locale } from '../i18n/i18n';
import Header from '../components/common/Header/index.astro';
import Footer from '../components/common/FooterUS/index.astro';
import MobileMenu from '../components/common/MobileMenu/index.astro';
import I18nProvider from '../components/i18n/I18nProvider.astro';
import YouTubeVideoModal from '../components/common/YouTubeVideoModal.astro';
import { routesConfig } from '../config/routes';
import esProducts from '../locales/es/products.json';
import usProducts from '../locales/us/products.json';
import { getHeaderColors } from '../config/headerColors';
import { ViewTransitions } from 'astro:transitions';
import "../styles/global.css";
import "../styles/global-us.css";

export interface Props {
  title?: string;
  description?: string;
  class?: string;
  headerColors?: {
    backgroundColor?: string;
    textColor?: string;
  };
  preloadImages?: string[];
}

const { title, description, class: className, headerColors, preloadImages = [] } = Astro.props;

const currentLang: Locale = 'us';
const { pathname } = Astro.url;

// Compute ES alternate path via routesConfig slug mapping
const recipeIds = {
  es: new Set(
    Object.keys(import.meta.glob('../locales/es/recipes/*.json')).map((file) => file.split('/').pop()!.replace('.json', ''))
  ),
  us: new Set(
    Object.keys(import.meta.glob('../locales/us/recipes/*.json')).map((file) => file.split('/').pop()!.replace('.json', ''))
  ),
};
const productIds = {
  es: new Set(esProducts.items.map((item) => item.id)),
  us: new Set(usProducts.items.map((item) => item.id)),
};

function getEsPath(): string | undefined {
  const segs = pathname.split('/').filter(Boolean);
  const slug = segs[1] || '';
  if (!slug) return '/es/';
  const route = routesConfig.find((item) => item.slugs.us === slug);
  const toSlug = route?.slugs.es;
  if (!route || !toSlug) return undefined;
  const rest = segs.slice(2);
  if (rest.length === 0) return `/es/${toSlug}/`;
  const detailId = rest.length === 1 ? rest[0] : '';
  if (route.id === 'recipes' && recipeIds.es.has(detailId)) return `/es/${toSlug}/${detailId}/`;
  if (route.id === 'products' && productIds.es.has(detailId)) return `/es/${toSlug}/${detailId}/`;
  return undefined;
}

const esPath = getEsPath();
const documentTitle = !title
  ? 'Zambos'
  : title.includes('Zambos')
    ? title
    : `${title} | Zambos`;

const headerColorConfig = getHeaderColors(pathname);

let customHeaderConfig = headerColorConfig;
if (headerColors) {
  customHeaderConfig = {
    ...headerColorConfig,
    backgroundColor: headerColors.backgroundColor ? `bg-[${headerColors.backgroundColor}]` : headerColorConfig.backgroundColor,
    textColor: headerColors.textColor ? headerColors.textColor : headerColorConfig.textColor,
  };
}
---
<html lang="en">
  <head>
    <GoogleTagManager />
    <Favicon />
    
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEOHead
      title={documentTitle}
      description={description}
      alternates={[
        ...(esPath ? [{ lang: 'es', path: esPath }] : []),
        { lang: 'en-US', path: pathname },
      ]}
    />
    <ViewTransitions />
    {preloadImages.map((src) => (
      <link rel="preload" as="image" href={src} />
    ))}
    <!-- Canonical & hreflang for SERPs -->
    <slot name="head" />
  </head>
  <body class={`font-sans min-h-screen flex flex-col us-layout ${className || ''}`}>
    <GoogleTagManager noscript />
    <I18nProvider>
      <slot name="header">
        <Header currentLang={currentLang} headerColors={headerColors} />
      </slot>
      <main transition:animate="slide" class="flex-1 flex flex-col overflow-hidden">
        <slot />
      </main>
      <Footer currentLang={currentLang} />
    </I18nProvider>
    
    <!-- Menú móvil al final del body para máximo z-index -->
    <MobileMenu currentLang={currentLang} headerColorConfig={customHeaderConfig} />
    <YouTubeVideoModal showTrigger={false} />
  </body>
</html>
