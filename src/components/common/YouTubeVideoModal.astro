---
interface Props {
  videoUrl?: string;
  showTrigger?: boolean;
}

const { videoUrl = '', showTrigger = true } = Astro.props;

function extractYouTubeId(url: string): string | null {
  const patterns = [
    /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/,
    /youtube\.com\/watch\?.*v=([a-zA-Z0-9_-]{11})/,
    /^([a-zA-Z0-9_-]{11})$/
  ];
  for (const pattern of patterns) {
    const match = url.match(pattern);
    if (match) return match[1];
  }
  return null;
}

const videoId = extractYouTubeId(videoUrl);
const embedUrl = videoId ? `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&playsinline=1` : '';
const hasContent = showTrigger ? !!videoId : true;
---

{hasContent && (
  <>
    {showTrigger && videoId && (
      <button
        type="button"
        class="youtube-modal-trigger inline-flex items-center justify-center"
        data-youtube-url={embedUrl}
        aria-label="Play video"
      >
        <slot />
      </button>
    )}

    <div
      id="youtubeModal"
      class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4"
      role="dialog"
      aria-modal="true"
    >
      <div id="youtubeModalInner" class="relative flex items-center justify-center w-full max-w-[90vw]">
        <div id="youtubeIframeContainer" class="relative w-full aspect-video bg-black rounded-lg overflow-hidden shadow-2xl">
          <button
            type="button"
            id="youtubeModalClose"
            class="absolute top-2 right-2 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-black/70 text-white hover:bg-black/90 transition-colors"
            aria-label="Close video"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>

          <iframe
            id="youtubeIframe"
            class="absolute inset-0 hidden h-full w-full"
            src=""
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>

          <video
            id="recipeNativeVideo"
            class="hidden h-full w-full object-contain"
            controls
            playsinline
          ></video>
        </div>
      </div>
    </div>
  </>
)}

<script>
  function resetContainerStyles(container: HTMLElement | null) {
    if (!container) return;
    container.style.width = '';
    container.style.height = '';
    container.style.maxWidth = '';
    container.style.maxHeight = '';
  }

  function fitShortsContainer(container: HTMLElement) {
    const ratio = 9 / 16;
    const maxW = window.innerWidth * 0.9;
    const maxH = window.innerHeight * 0.85;

    let height = maxH;
    let width = height * ratio;

    if (width > maxW) {
      width = maxW;
      height = width / ratio;
    }

    container.style.width = `${Math.round(width)}px`;
    container.style.height = `${Math.round(height)}px`;
    container.style.maxWidth = '90vw';
    container.style.maxHeight = '85vh';
  }

  function applyYouTubeLayout(
    modal: HTMLElement,
    inner: HTMLElement | null,
    container: HTMLElement | null,
    isShort: boolean
  ) {
    modal.classList.add('bg-black/80', 'backdrop-blur-sm', 'p-4');
    modal.classList.remove('bg-black');

    if (inner) {
      inner.className = 'relative flex items-center justify-center w-full max-w-[90vw]';
    }

    if (container) {
      resetContainerStyles(container);
      if (isShort) {
        container.className = 'relative bg-black rounded-lg overflow-hidden shadow-2xl';
        fitShortsContainer(container);
      } else {
        container.className = 'relative w-full max-w-[900px] aspect-video bg-black rounded-lg overflow-hidden shadow-2xl';
      }
    }
  }

  function applyNativeVideoLayout(
    modal: HTMLElement,
    inner: HTMLElement | null,
    container: HTMLElement | null
  ) {
    modal.classList.add('bg-black/80', 'backdrop-blur-sm', 'p-4');
    modal.classList.remove('bg-black');

    if (inner) {
      inner.className = 'relative flex items-center justify-center w-full max-w-[90vw]';
    }

    if (container) {
      resetContainerStyles(container);
      container.className = 'relative bg-black rounded-lg overflow-hidden shadow-2xl';
    }
  }

  function fitNativeVideo(container: HTMLElement, video: HTMLVideoElement) {
    const ratio = video.videoWidth / video.videoHeight;
    if (!ratio || !Number.isFinite(ratio)) return;

    const maxW = Math.min(window.innerWidth * 0.9, 1200);
    const maxH = window.innerHeight * 0.85;

    let width = maxW;
    let height = width / ratio;

    if (height > maxH) {
      height = maxH;
      width = height * ratio;
    }

    container.style.width = `${Math.round(width)}px`;
    container.style.height = `${Math.round(height)}px`;
    container.style.maxWidth = '90vw';
    container.style.maxHeight = '85vh';
  }

  function initRecipeVideoModal() {
    const modal = document.getElementById('youtubeModal');
    const iframe = document.getElementById('youtubeIframe') as HTMLIFrameElement | null;
    const nativeVideo = document.getElementById('recipeNativeVideo') as HTMLVideoElement | null;
    const closeBtn = document.getElementById('youtubeModalClose');
    const inner = document.getElementById('youtubeModalInner');
    const container = document.getElementById('youtubeIframeContainer');

    if (!modal || !iframe || !nativeVideo || !closeBtn) return;
    if ((modal as any).__recipeVideoModalBound) return;
    (modal as any).__recipeVideoModalBound = true;

    const modalEl = modal;
    const iframeEl = iframe;
    const nativeVideoEl = nativeVideo;
    const closeBtnEl = closeBtn;

    function closeModal() {
      iframeEl.src = '';
      iframeEl.classList.add('hidden');
      nativeVideoEl.pause();
      nativeVideoEl.removeAttribute('src');
      nativeVideoEl.load();
      nativeVideoEl.classList.add('hidden');
      resetContainerStyles(container);
      modalEl.classList.add('hidden');
      modalEl.classList.remove('flex');
      document.body.style.overflow = '';
    }

    function openYouTube(url: string, isShort = false) {
      nativeVideoEl.pause();
      nativeVideoEl.removeAttribute('src');
      nativeVideoEl.load();
      nativeVideoEl.classList.add('hidden');

      applyYouTubeLayout(modalEl, inner, container, isShort);

      iframeEl.src = url;
      iframeEl.classList.remove('hidden');
      modalEl.classList.remove('hidden');
      modalEl.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function openNativeVideo(url: string) {
      iframeEl.src = '';
      iframeEl.classList.add('hidden');

      applyNativeVideoLayout(modalEl, inner, container);

      nativeVideoEl.onloadedmetadata = () => {
        if (container) fitNativeVideo(container, nativeVideoEl);
      };

      nativeVideoEl.src = url;
      nativeVideoEl.classList.remove('hidden');
      nativeVideoEl.play().catch(() => {});

      modalEl.classList.remove('hidden');
      modalEl.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    closeBtnEl.addEventListener('click', closeModal);

    modalEl.addEventListener('click', (e) => {
      if (e.target === modalEl) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modalEl.classList.contains('hidden')) {
        closeModal();
      }
    });

    (window as any).__openRecipeYouTube = openYouTube;
    (window as any).__openRecipeNativeVideo = openNativeVideo;
    (window as any).__closeRecipeVideoModal = closeModal;
  }

  if (!(window as any).__recipeVideoClickBound) {
    (window as any).__recipeVideoClickBound = true;

    document.addEventListener('click', (e) => {
      const youtubeTrigger = (e.target as HTMLElement).closest('[data-youtube-url]');
      if (youtubeTrigger) {
        e.preventDefault();
        e.stopPropagation();
        const url = youtubeTrigger.getAttribute('data-youtube-url');
        if (!url) return;

        const openYouTube = (window as any).__openRecipeYouTube as ((url: string, isShort?: boolean) => void) | undefined;
        if (openYouTube) {
          const isShort = youtubeTrigger.getAttribute('data-youtube-is-short') === 'true';
          openYouTube(url, isShort);
          return;
        }

        const modal = document.getElementById('youtubeModal');
        const iframe = document.getElementById('youtubeIframe') as HTMLIFrameElement | null;
        const inner = document.getElementById('youtubeModalInner');
        const container = document.getElementById('youtubeIframeContainer');
        const nativeVideo = document.getElementById('recipeNativeVideo') as HTMLVideoElement | null;
        if (!modal || !iframe || !nativeVideo) return;

        nativeVideo.pause();
        nativeVideo.removeAttribute('src');
        nativeVideo.load();
        nativeVideo.classList.add('hidden');

        const isShort = youtubeTrigger.getAttribute('data-youtube-is-short') === 'true';
        applyYouTubeLayout(modal, inner, container, isShort);

        iframe.src = url;
        iframe.classList.remove('hidden');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        return;
      }

      const videoTrigger = (e.target as HTMLElement).closest('[data-video-url]');
      if (videoTrigger) {
        e.preventDefault();
        e.stopPropagation();
        const url = videoTrigger.getAttribute('data-video-url');
        if (!url) return;

        const openNativeVideo = (window as any).__openRecipeNativeVideo as ((url: string) => void) | undefined;
        if (openNativeVideo) {
          openNativeVideo(url);
          return;
        }

        const modal = document.getElementById('youtubeModal');
        const iframe = document.getElementById('youtubeIframe') as HTMLIFrameElement | null;
        const inner = document.getElementById('youtubeModalInner');
        const container = document.getElementById('youtubeIframeContainer');
        const nativeVideo = document.getElementById('recipeNativeVideo') as HTMLVideoElement | null;
        if (!modal || !iframe || !nativeVideo || !container) return;

        iframe.src = '';
        iframe.classList.add('hidden');

        applyNativeVideoLayout(modal, inner, container);

        nativeVideo.onloadedmetadata = () => fitNativeVideo(container, nativeVideo);
        nativeVideo.src = url;
        nativeVideo.classList.remove('hidden');
        nativeVideo.play().catch(() => {});

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    });
  }

  initRecipeVideoModal();
  document.addEventListener('astro:page-load', initRecipeVideoModal);
</script>

<style>
  #youtubeIframeContainer iframe:not(.hidden) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  #youtubeIframeContainer video:not(.hidden) {
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
