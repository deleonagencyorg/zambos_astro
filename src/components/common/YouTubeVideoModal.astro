---
interface Props {
  videoUrl?: string;
  showTrigger?: boolean;
}

const { videoUrl = '', showTrigger = true } = Astro.props;

function extractYouTubeId(url: string): string | null {
  if (!url) return null;
  const patterns = [
    /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/,
    /youtube\.com\/watch\?.*v=([a-zA-Z0-9_-]{11})/,
    /^([a-zA-Z0-9_-]{11})$/
  ];
  for (const pattern of patterns) {
    const match = url.match(pattern);
    if (match) return match[1];
  }
  return null;
}

const videoId = extractYouTubeId(videoUrl);
const embedUrl = videoId ? `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0` : videoUrl;
const hasContent = showTrigger ? !!videoUrl : true;
---

{hasContent && (
  <>
    {showTrigger && videoUrl && (
      <button
        type="button"
        class="youtube-modal-trigger inline-flex items-center justify-center"
        data-youtube-url={embedUrl}
        data-video-url={videoUrl}
        aria-label="Play video"
      >
        <slot />
      </button>
    )}

    <div
      id="youtubeModal"
      class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/80 backdrop-blur-sm"
      role="dialog"
      aria-modal="true"
    >
      <div id="youtubeModalInner" class="relative w-full max-w-[90vw] md:max-w-[80vw] lg:max-w-[900px]">
        <button
          type="button"
          id="youtubeModalClose"
          class="absolute -top-10 right-0 text-white hover:text-gray-300 transition-colors"
          aria-label="Close video"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div id="youtubeIframeContainer" class="relative w-full aspect-video bg-black rounded-lg overflow-hidden shadow-2xl flex items-center justify-center">
          <iframe
            id="youtubeIframe"
            class="absolute inset-0 w-full h-full hidden"
            src=""
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
          <video
            id="youtubeVideoPlayer"
            class="w-full h-full object-contain hidden"
            controls
            playsinline
            preload="metadata"
          ></video>
        </div>
      </div>
    </div>
  </>
)}

<script>
  function isYouTube(url: string): boolean {
    if (!url) return false;
    return /youtu\.be|youtube\.com/.test(url);
  }

  function extractYouTubeId(url: string): string | null {
    if (!url) return null;
    const patterns = [
      /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/,
      /youtube\.com\/watch\?.*v=([a-zA-Z0-9_-]{11})/,
      /^([a-zA-Z0-9_-]{11})$/
    ];
    for (const pattern of patterns) {
      const match = url.match(pattern);
      if (match) return match[1];
    }
    return null;
  }

  function openVideoModalGlobal(rawUrl: string, isShort = false) {
    const modal = document.getElementById('youtubeModal');
    const iframe = document.getElementById('youtubeIframe') as HTMLIFrameElement | null;
    const videoPlayer = document.getElementById('youtubeVideoPlayer') as HTMLVideoElement | null;
    const inner = document.getElementById('youtubeModalInner');
    const container = document.getElementById('youtubeIframeContainer');
    const closeBtn = document.getElementById('youtubeModalClose');
    if (!modal) return;

    const isMobile = window.innerWidth < 768;

    if (isYouTube(rawUrl)) {
      const ytId = extractYouTubeId(rawUrl);
      const embedUrl = ytId ? `https://www.youtube.com/embed/${ytId}?autoplay=1&rel=0` : rawUrl;

      if (videoPlayer) {
        videoPlayer.pause();
        videoPlayer.src = '';
        videoPlayer.removeAttribute('src');
        videoPlayer.load();
        videoPlayer.classList.add('hidden');
      }

      if (isShort && isMobile) {
        modal.classList.remove('bg-black/80', 'backdrop-blur-sm');
        modal.classList.add('bg-black');
        if (inner) inner.className = 'fixed inset-0 w-full h-full';
        if (container) container.className = 'w-full h-full';
        if (closeBtn) closeBtn.className = 'fixed top-4 right-4 z-[10000] text-white hover:text-gray-300 transition-colors';
      } else {
        modal.classList.add('bg-black/80', 'backdrop-blur-sm');
        modal.classList.remove('bg-black');
        if (inner) inner.className = 'relative w-full max-w-[90vw] md:max-w-[80vw] lg:max-w-[900px]';
        if (container) container.className = 'relative w-full aspect-video bg-black rounded-lg overflow-hidden shadow-2xl flex items-center justify-center';
        if (closeBtn) closeBtn.className = 'absolute -top-10 right-0 text-white hover:text-gray-300 transition-colors';
      }

      if (iframe) {
        iframe.src = embedUrl;
        iframe.classList.remove('hidden');
      }
    } else {
      if (iframe) {
        iframe.src = '';
        iframe.classList.add('hidden');
      }

      if (isMobile) {
        modal.classList.remove('bg-black/80', 'backdrop-blur-sm');
        modal.classList.add('bg-black');
        if (inner) inner.className = 'fixed inset-0 w-full h-full';
        if (container) container.className = 'w-full h-full flex items-center justify-center';
        if (closeBtn) closeBtn.className = 'fixed top-4 right-4 z-[10000] text-white hover:text-gray-300 transition-colors';
      } else {
        modal.classList.add('bg-black/80', 'backdrop-blur-sm');
        modal.classList.remove('bg-black');
        if (inner) inner.className = 'relative w-full max-w-[90vw] md:max-w-[80vw] lg:max-w-[900px] max-h-[85vh]';
        if (container) container.className = 'relative w-full aspect-video bg-black rounded-lg overflow-hidden shadow-2xl flex items-center justify-center';
        if (closeBtn) closeBtn.className = 'absolute -top-10 right-0 text-white hover:text-gray-300 transition-colors';
      }

      if (videoPlayer) {
        videoPlayer.src = rawUrl;
        videoPlayer.classList.remove('hidden');
        videoPlayer.play().catch((err) => {
          console.warn('Autoplay prevented by browser:', err);
        });
      }
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeVideoModalGlobal() {
    const modal = document.getElementById('youtubeModal');
    const iframe = document.getElementById('youtubeIframe') as HTMLIFrameElement | null;
    const videoPlayer = document.getElementById('youtubeVideoPlayer') as HTMLVideoElement | null;
    if (!modal) return;

    if (iframe) {
      iframe.src = '';
      iframe.classList.add('hidden');
    }

    if (videoPlayer) {
      videoPlayer.pause();
      videoPlayer.src = '';
      videoPlayer.removeAttribute('src');
      videoPlayer.load();
      videoPlayer.classList.add('hidden');
    }

    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  (window as any).openVideoModal = openVideoModalGlobal;
  (window as any).__openVideoModal = openVideoModalGlobal;
  (window as any).closeVideoModal = closeVideoModalGlobal;
  (window as any).__closeVideoModal = closeVideoModalGlobal;

  function initYouTubeModal() {
    const modal = document.getElementById('youtubeModal');
    const closeBtn = document.getElementById('youtubeModalClose');
    if (!modal || !closeBtn) return;

    if ((modal as any).__ytModalBound) return;
    (modal as any).__ytModalBound = true;

    closeBtn.addEventListener('click', closeVideoModalGlobal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeVideoModalGlobal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeVideoModalGlobal();
      }
    });
  }

  if (!(window as any).__ytClickBound) {
    (window as any).__ytClickBound = true;
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('[data-youtube-url], [data-video-url], [data-video]');
      if (trigger) {
        e.preventDefault();
        e.stopPropagation();
        const url = trigger.getAttribute('data-video-url') || trigger.getAttribute('data-youtube-url') || trigger.getAttribute('data-video');
        if (url) {
          const isShort = trigger.getAttribute('data-youtube-is-short') === 'true';
          openVideoModalGlobal(url, isShort);
        }
      }
    });
  }

  initYouTubeModal();
  document.addEventListener('astro:page-load', initYouTubeModal);
</script>

<style>
  #youtubeIframeContainer iframe {
    border: none;
  }
</style>

