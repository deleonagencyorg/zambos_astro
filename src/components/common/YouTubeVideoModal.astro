---
interface Props {
  videoUrl?: string;
  showTrigger?: boolean;
}

const { videoUrl = '', showTrigger = true } = Astro.props;

function extractYouTubeId(url: string): string | null {
  const patterns = [
    /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/,
    /youtube\.com\/watch\?.*v=([a-zA-Z0-9_-]{11})/,
    /^([a-zA-Z0-9_-]{11})$/
  ];
  for (const pattern of patterns) {
    const match = url.match(pattern);
    if (match) return match[1];
  }
  return null;
}

const videoId = extractYouTubeId(videoUrl);
const embedUrl = videoId ? `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0` : '';
const hasContent = showTrigger ? !!videoId : true;

const closeBtnClass =
  'video-modal-close absolute top-2 right-2 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-black/70 text-white hover:bg-black/90 transition-colors shadow-lg';
---

{hasContent && (
  <>
    {showTrigger && videoId && (
      <button
        type="button"
        class="youtube-modal-trigger inline-flex items-center justify-center"
        data-youtube-url={embedUrl}
        aria-label="Play video"
      >
        <slot />
      </button>
    )}

    <!-- YouTube modal -->
    <div
      id="youtubeModal"
      class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4"
      role="dialog"
      aria-modal="true"
    >
      <div id="youtubeModalInner" class="relative w-full max-w-[90vw] md:max-w-[80vw] lg:max-w-[900px]">
        <div id="youtubeIframeContainer" class="relative w-full aspect-video bg-black rounded-lg overflow-hidden shadow-2xl">
          <button
            type="button"
            id="youtubeModalClose"
            class={closeBtnClass}
            aria-label="Close video"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
          <iframe
            id="youtubeIframe"
            class="absolute inset-0 w-full h-full"
            src=""
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>

    <!-- Native video lightbox -->
    <div
      id="nativeVideoModal"
      class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4"
      role="dialog"
      aria-modal="true"
    >
      <div id="nativeVideoModalInner" class="relative flex items-center justify-center max-w-[95vw] max-h-[90vh]">
        <div id="nativeVideoContainer" class="relative bg-black rounded-lg overflow-hidden shadow-2xl">
          <button
            type="button"
            id="nativeVideoModalClose"
            class={closeBtnClass}
            aria-label="Close video"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
          <video
            id="nativeVideo"
            class="block max-w-[95vw] max-h-[90vh] w-auto h-auto"
            controls
            playsinline
          ></video>
        </div>
      </div>
    </div>
  </>
)}

<script>
  function applyYouTubeLayout(isShort: boolean) {
    const inner = document.getElementById('youtubeModalInner');
    const container = document.getElementById('youtubeIframeContainer');
    if (!inner || !container) return;

    if (isShort) {
      inner.className = 'relative flex items-center justify-center max-w-[95vw] max-h-[90vh]';
      container.className =
        'relative bg-black rounded-lg overflow-hidden shadow-2xl aspect-[9/16] w-[min(95vw,calc(90vh*9/16))] max-h-[90vh]';
    } else {
      inner.className = 'relative w-full max-w-[90vw] md:max-w-[80vw] lg:max-w-[900px]';
      container.className =
        'relative w-full aspect-video bg-black rounded-lg overflow-hidden shadow-2xl';
    }
  }

  function applyNativeVideoLayout(video: HTMLVideoElement) {
    const container = document.getElementById('nativeVideoContainer');
    if (!container || !video.videoWidth || !video.videoHeight) return;

    const ratio = video.videoWidth / video.videoHeight;
    const maxW = Math.min(window.innerWidth * 0.95, 1200);
    const maxH = window.innerHeight * 0.9;

    let width = maxW;
    let height = width / ratio;

    if (height > maxH) {
      height = maxH;
      width = height * ratio;
    }

    container.style.width = `${width}px`;
    container.style.height = `${height}px`;
    video.style.width = '100%';
    video.style.height = '100%';
    video.style.objectFit = 'contain';
  }

  function showModal(modal: HTMLElement) {
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function hideModal(modal: HTMLElement) {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  function openYouTubeModal(url: string, isShort = false) {
    const youtubeModal = document.getElementById('youtubeModal');
    const youtubeIframe = document.getElementById('youtubeIframe') as HTMLIFrameElement | null;
    if (!youtubeModal || !youtubeIframe) return;

    applyYouTubeLayout(isShort);
    youtubeIframe.src = url;
    showModal(youtubeModal);
  }

  function closeYouTubeModal() {
    const youtubeModal = document.getElementById('youtubeModal');
    const youtubeIframe = document.getElementById('youtubeIframe') as HTMLIFrameElement | null;
    if (!youtubeModal || !youtubeIframe) return;

    youtubeIframe.src = '';
    hideModal(youtubeModal);
  }

  function openNativeModal(url: string) {
    const nativeModal = document.getElementById('nativeVideoModal');
    const nativeVideo = document.getElementById('nativeVideo') as HTMLVideoElement | null;
    const container = document.getElementById('nativeVideoContainer');
    if (!nativeModal || !nativeVideo) return;

    if (container) {
      container.style.width = '';
      container.style.height = '';
    }

    nativeVideo.pause();
    nativeVideo.removeAttribute('src');
    nativeVideo.load();
    nativeVideo.src = url;

    const onMetadata = () => {
      applyNativeVideoLayout(nativeVideo);
      nativeVideo.removeEventListener('loadedmetadata', onMetadata);
    };
    nativeVideo.addEventListener('loadedmetadata', onMetadata);
    if (nativeVideo.readyState >= 1) onMetadata();

    showModal(nativeModal);

    nativeVideo.play().catch(() => {});
  }

  function closeNativeModal() {
    const nativeModal = document.getElementById('nativeVideoModal');
    const nativeVideo = document.getElementById('nativeVideo') as HTMLVideoElement | null;
    if (!nativeModal || !nativeVideo) return;

    nativeVideo.pause();
    nativeVideo.src = '';
    hideModal(nativeModal);
  }

  function bindVideoModalEvents() {
    delete (window as any).__videoModalsBound;
    delete (window as any).__ytClickBound;

    if ((window as any).__videoModalEventsBound) return;
    (window as any).__videoModalEventsBound = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      if (target.closest('#youtubeModalClose')) {
        e.preventDefault();
        closeYouTubeModal();
        return;
      }

      if (target.closest('#nativeVideoModalClose')) {
        e.preventDefault();
        closeNativeModal();
        return;
      }

      const youtubeModal = document.getElementById('youtubeModal');
      if (youtubeModal && target === youtubeModal) {
        closeYouTubeModal();
        return;
      }

      const nativeModal = document.getElementById('nativeVideoModal');
      if (nativeModal && target === nativeModal) {
        closeNativeModal();
        return;
      }

      const youtubeTrigger = target.closest('[data-youtube-url]');
      if (youtubeTrigger) {
        e.preventDefault();
        e.stopPropagation();
        const url = youtubeTrigger.getAttribute('data-youtube-url');
        if (url) {
          const isShort = youtubeTrigger.getAttribute('data-youtube-is-short') === 'true';
          openYouTubeModal(url, isShort);
        }
        return;
      }

      const nativeTrigger = target.closest('[data-video-url]');
      if (nativeTrigger) {
        e.preventDefault();
        e.stopPropagation();
        const url = nativeTrigger.getAttribute('data-video-url');
        if (url) openNativeModal(url);
      }
    }, true);

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const youtubeModal = document.getElementById('youtubeModal');
      const nativeModal = document.getElementById('nativeVideoModal');
      if (youtubeModal && !youtubeModal.classList.contains('hidden')) closeYouTubeModal();
      if (nativeModal && !nativeModal.classList.contains('hidden')) closeNativeModal();
    });

    window.addEventListener('resize', () => {
      const nativeModal = document.getElementById('nativeVideoModal');
      const nativeVideo = document.getElementById('nativeVideo') as HTMLVideoElement | null;
      if (nativeModal && nativeVideo && !nativeModal.classList.contains('hidden') && nativeVideo.videoWidth) {
        applyNativeVideoLayout(nativeVideo);
      }
    });
  }

  bindVideoModalEvents();
  document.addEventListener('astro:page-load', bindVideoModalEvents);
</script>

<style>
  #youtubeIframeContainer iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  #nativeVideoContainer video {
    display: block;
  }
</style>
