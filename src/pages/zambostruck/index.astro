---
import TruckView from '../../views/Truck/index.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { setLocale } from '../../i18n/i18n';
import { getHeaderColors } from '../../config/headerColors';

// Forzar idioma español
setLocale('es');

const headerColorConfig = getHeaderColors('truck');
---

<MainLayout
  title="Zambos Truck"
  description="Descubre los paquetes de Zambos Truck"
  headerColors={headerColorConfig}
  class="bg-green text-center"
>
  <TruckView />
</MainLayout>

