---
// src/pages/[lang]/[pageSlug].astro
import { routesConfig, findRouteBySlug } from '../../config/routes';
import { setLocale, type Locale } from '../../i18n/i18n';
import { getHeaderColors } from '../../config/headerColors';
import MainLayout from '../../layouts/MainLayout.astro';
import MainLayoutUS from '../../layouts/MainLayoutUS.astro';
import { getAllPages, isHomePage, type CMSPage } from '../../services/api/pages';
import { getSiteTextMap } from '../../services/api/site-texts';

// Define the expected structure of the dynamically imported modules
interface PageModule {
  default: any; // Using 'any' for simplicity with dynamic Astro component imports
}

// Map de imágenes de fondo por routeId para preload
const usBgImages: Record<string, string[]> = {
  products:  ['https://snack.yummiespromociones.com/SnacksyummiesAssets/bg-productsus.webp'],
  recipes:   ['https://snack.yummiespromociones.com/SnacksyummiesAssets/bgrecipesus.webp'],
  contact:   ['https://snack.yummiespromociones.com/SnacksyummiesAssets/bgcontacto.webp'],
  about_us:  ['https://snack.yummiespromociones.com/SnacksyummiesAssets/bgblueus.webp', 'https://snack.yummiespromociones.com/SnacksyummiesAssets/bgredusa2.webp'],
};

// Obtener todos los posibles componentes de contenido de página
// La ruta para Astro.glob debe ser relativa desde este archivo o absoluta desde el proyecto.
// Usaremos una ruta que asume que los componentes están en src/views/*/index.astro
const pageComponents = await Astro.glob('../../views/*/index.astro');
const pageComponentsUS = await Astro.glob('../../views-us/*/index.astro');

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: string; pageSlug: string }; props: { routeId: string; cmsPage?: CMSPage; siteTexts: Record<string, string> } }> = [];
  for (const route of routesConfig) {
    if (route.id === 'home') continue; // La página de inicio se maneja en [lang]/index.astro

    for (const lang in route.slugs) {
      const siteTexts = await getSiteTextMap(lang);
      paths.push({
        params: { lang, pageSlug: route.slugs[lang] },
        props: { routeId: route.id, siteTexts },
      });
    }
  }

  for (const lang of ['es', 'us']) {
    const [cmsPages, siteTexts] = await Promise.all([getAllPages(lang), getSiteTextMap(lang)]);
    const configuredSlugs = new Set(
      routesConfig.map((route) => route.slugs[lang]).filter(Boolean)
    );
    for (const cmsPage of cmsPages) {
      if (!cmsPage.slug || cmsPage.slug.includes('/') || configuredSlugs.has(cmsPage.slug) || isHomePage(cmsPage)) continue;
      paths.push({
        params: { lang, pageSlug: cmsPage.slug },
        props: { routeId: 'cms_page', cmsPage, siteTexts },
      });
    }
  }

  return paths;
}

const { lang, pageSlug } = Astro.params as { lang: Locale; pageSlug: string };
const { routeId, cmsPage, siteTexts = {} } = Astro.props as {
  routeId: string;
  cmsPage?: CMSPage;
  siteTexts?: Record<string, string>;
};

setLocale(lang);

let pageTitle = '';
let pageDescription = '';
let ContentComponent;

if (cmsPage) {
  pageTitle = cmsPage.metaTitle || cmsPage.title;
  pageDescription = cmsPage.metaDescription || cmsPage.excerpt || '';
} else {
  // Obtener la ruta actual para páginas normales
  const currentRoute = findRouteBySlug(lang, pageSlug);
  console.log('Ruta encontrada:', currentRoute?.id);

  // Si no es una ruta de detalle o no se encontró la receta, seguir con el flujo normal
  if (!currentRoute) {
    console.error(`Ruta no encontrada para lang=${lang}, pageSlug=${pageSlug}`);
    return Astro.redirect(`/${lang}/404`);
  }

  // Usar import.meta.glob()
  // Esto devuelve un objeto donde las claves son las rutas y los valores son funciones para importar el módulo.
  const modules = lang === 'us'
    ? import.meta.glob('../../views-us/*/index.astro')
    : import.meta.glob('../../views/*/index.astro');

  // DEBUG: Log de los módulos encontrados por import.meta.glob()
  console.log('Módulos de VISTAS encontrados por import.meta.glob():', Object.keys(modules));

  // Transformar la ruta del contentComponent para que coincida con las claves de import.meta.glob()
  // Asumimos que [pageSlug].astro está en src/pages/[lang]/ y los componentes en src/components/pages/
  // Por lo tanto, '@/' se traduce a '../../' desde la perspectiva de [pageSlug].astro para llegar a la raíz de src/
  const targetModulePath = lang === 'us'
    ? currentRoute.contentComponent.replace('@/views/', '../../views-us/')
    : currentRoute.contentComponent.replace('@/', '../../');

  // DEBUG: Log de la ruta del módulo que se busca
  console.log(`Buscando módulo con ruta: ${targetModulePath} para la ruta ID: ${currentRoute.id}`);

  const moduleLoader = modules[targetModulePath]; // modules es Record<string, () => Promise<any>>

  if (!moduleLoader) {
    console.error(`Cargador de módulo no encontrado para la ruta: ${currentRoute.id}. Se esperaba la ruta: ${targetModulePath}`);
    console.error('Módulos de VISTAS disponibles de import.meta.glob():', Object.keys(modules));
    return Astro.redirect(`/${lang}/404`);
  }

  const loadedModule = await moduleLoader(); // Ejecutar la función para cargar el módulo
  const ContentComponentModule = loadedModule as PageModule; // Explicitly cast to PageModule
  ContentComponent = ContentComponentModule.default;

  if (!ContentComponent) {
    console.error(`Componente por defecto no exportado o no encontrado en el módulo: ${targetModulePath} para la ruta ID: ${currentRoute.id}`);
    return Astro.redirect(`/${lang}/404`);
  }

  pageTitle = siteTexts[`meta.${currentRoute.id}.title`] || '';
  pageDescription = siteTexts[`meta.${currentRoute.id}.description`] || '';
}

const headerColorConfig = getHeaderColors(routeId || 'cms_page');
const cmsFeaturedImage = cmsPage?.featuredImage?.seoUrl || cmsPage?.featuredImage?.originalUrl;
---

{!cmsPage && lang === 'us' && (
  <MainLayoutUS title={pageTitle} description={pageDescription} preloadImages={usBgImages[Astro.props.routeId] ?? []}>
    <ContentComponent currentLang={lang} headerColorConfig={headerColorConfig} />
  </MainLayoutUS>
)}

{!cmsPage && lang !== 'us' && (
  <MainLayout title={pageTitle} description={pageDescription}>
    <ContentComponent currentLang={lang} headerColorConfig={headerColorConfig} />
  </MainLayout>
)}

{cmsPage && lang === 'us' && (
  <MainLayoutUS title={pageTitle} description={pageDescription}>
    <main class="container mx-auto max-w-5xl px-4 py-12">
      {cmsPage.showPageTitle !== false && <h1 class="mb-8 text-4xl font-bold">{cmsPage.title}</h1>}
      {cmsFeaturedImage && <img class="mb-8 h-auto w-full rounded-lg object-cover" src={cmsFeaturedImage} alt={cmsPage.title} />}
      <article class="cms-page-content" set:html={cmsPage.content || ''} />
    </main>
  </MainLayoutUS>
)}

{cmsPage && lang !== 'us' && (
  <MainLayout title={pageTitle} description={pageDescription}>
    <main class="container mx-auto max-w-5xl px-4 py-12">
      {cmsPage.showPageTitle !== false && <h1 class="mb-8 text-4xl font-bold">{cmsPage.title}</h1>}
      {cmsFeaturedImage && <img class="mb-8 h-auto w-full rounded-lg object-cover" src={cmsFeaturedImage} alt={cmsPage.title} />}
      <article class="cms-page-content" set:html={cmsPage.content || ''} />
    </main>
  </MainLayout>
)}
