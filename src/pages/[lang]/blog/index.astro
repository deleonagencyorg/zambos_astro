---
import BlogListing from '../../../views/Blog/index.astro';
import BlogListingUS from '../../../views-us/Blog/index.astro';
import { type Locale } from '../../../i18n/i18n';
import { getBlogPosts } from '../../../services/api/news';

export async function getStaticPaths() {
  const locales = ['us', 'es'];
  const paths = [];
  for (const locale of locales) {
    paths.push({
      params: { lang: locale },
      props: { currentLang: locale as Locale, blogPosts: await getBlogPosts(locale) },
    });
  }
  return paths;
}

const { currentLang, blogPosts } = Astro.props;
---

{currentLang === 'us' ? (
  <BlogListingUS blogPosts={blogPosts} currentLang={currentLang} />
) : (
  <BlogListing blogPosts={blogPosts} currentLang={currentLang} />
)}
