---
import TruckView from '../../../views/Truck/index.astro';
import TruckViewUS from '../../../views-us/Truck/index.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import MainLayoutUS from '../../../layouts/MainLayoutUS.astro';
import { type Locale, setLocale } from '../../../i18n/i18n';
import { getHeaderColors } from '../../../config/headerColors';

export async function getStaticPaths() {
  const locales = ['us', 'es'];
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { currentLang: locale as Locale }
  }));
}

const { currentLang } = Astro.props;
setLocale(currentLang);

// Set header color config for white background and primary color text using the getHeaderColors function
const headerColorConfig = getHeaderColors('truck');
---

{currentLang === 'us' ? (
  <MainLayoutUS title="Zambos Truck" description="Discover Zambos Truck packages" headerColors={headerColorConfig}>
    <TruckViewUS currentLang={currentLang} headerColorConfig={headerColorConfig} />
  </MainLayoutUS>
) : (
  <MainLayout title="Zambos Truck" description="Descubre los paquetes de Zambos Truck" headerColors={headerColorConfig}>
    <TruckView currentLang={currentLang} headerColorConfig={headerColorConfig} />
  </MainLayout>
)}
