---
// src/pages/[lang]/productos/[productId].astro
import { setLocale, type Locale } from "../../../i18n/i18n";
import MainLayout from "../../../layouts/MainLayout.astro";
import ProductDetail from "../../../views/Products/Detail/index.astro";
import { getAllProducts } from "../../../services/api/products";

export async function getStaticPaths() {
  const locale = "es";
  const products = await getAllProducts(locale);
  return products.map((product) => ({
    params: { lang: locale, productId: product.slug },
    props: { product, currentLang: locale },
  }));
}

const { product, currentLang } = Astro.props;
const { lang, productId } = Astro.params;

setLocale(lang as Locale);

const backgroundColor = product?.background_color || product?.backgroundColor || "#E30613";
const headerTextColor = "#FFFFFF";

const specialBackgrounds = ["#FDE820", "#BEDE89"];
const isSpecialBackground = specialBackgrounds.includes(backgroundColor);

const headerColors = {
  backgroundColor: backgroundColor,
  textColor: headerTextColor,
  isSpecialBackground: isSpecialBackground
};
---

<MainLayout title={product?.name || "Zambos"} headerColors={headerColors}>
  <ProductDetail currentLang={currentLang} productId={productId} />
</MainLayout>
